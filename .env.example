# Copy to .env for local dev. Never commit the real .env.
CARENOTE_JWT_SECRET=dev-only-insecure-secret-change-me

# Session lifetime in minutes. There is no refresh flow (DECISIONS.md D-016),
# so this is the entire session budget. Keep it short.
CARENOTE_JWT_TTL_MINUTES=60

# Set to true in ANY environment served over HTTPS. Off for localhost only,
# because a Secure cookie is not sent over plain HTTP.
CARENOTE_COOKIE_SECURE=false

CARENOTE_DB_URL=sqlite:///./carenote.db

# LLM provider: "stub" (default, offline, deterministic) or "anthropic"
CARENOTE_LLM_PROVIDER=stub
CARENOTE_LLM_MODEL=claude-sonnet-4-5
# Only read when CARENOTE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Phase 5: ambient voice capture ---------------------------------------
# Speech recogniser: "stub" (default) is IN-PROCESS and SIMULATED — it does not
# transcribe, it returns a fixed synthetic transcript and flags every capture as
# simulated. "local" is the documented production path (unimplemented).
# "remote" is a hosted vendor (unimplemented).
CARENOTE_ASR_PROVIDER=stub
CARENOTE_ASR_MODEL=whisper-large-v3

# Audio CANNOT be redacted before transcription — there is no regex over a
# waveform (see backend/app/ai/asr_client.py). Sending a recording to a hosted
# recogniser therefore means sending un-redacted patient speech off-box, so it
# requires a deliberate opt-in. The remote provider RAISES when this is false
# rather than quietly falling back to the stub.
# Only set true if that transfer is covered by a data processing agreement.
CARENOTE_ASR_ALLOW_AUDIO_EGRESS=false
